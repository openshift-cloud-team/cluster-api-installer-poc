# Copy this to <cluster-dir>/azurelocal.env and fill it in.
#
# On AWS the equivalent values came from metadata.json and `aws sts get-caller-identity`.
# metadata.json for platform: baremetal carries nothing Azure Local specific, and MOC has no
# caller-identity equivalent, so they are configured here instead.

# MOC resource group that will hold the VMs, NICs and disks for this cluster.
RESOURCE_GROUP="ocp-guests"

# MOC location.
#
# Must NOT be one of the ten names in cloud/defaults.go SupportedAvailabilityZoneLocations:
#   centralus, eastus, eastus2, westus2, francecentral,
#   northeurope, uksouth, westeurope, japaneast, southeastasia
#
# isAvailabilityZoneSupported() is a plain string match against that list, and when it matches the
# reconciler dereferences spec.availabilityZone.Enabled without a nil check. Our machines omit
# availabilityZone, so a matching location panics the controller.
LOCATION="MocLocation"

# Virtual network the VMs attach to, and the resource group holding it.
#
# CAPHCI creates this if it does not exist, as a MOC "Transparent" network -- the vNIC is bridged
# straight onto the physical L2, so the segment's DHCP server supplies addresses. Leaving
# VNET_NAME empty makes the provider invent one at DefaultVnetCIDR 10.0.0.0/8.
#
# Use a dedicated vnet. CAPHCI's delete path has an inverted ownership check: it skips deletion
# when the OWNER tag is absent, nil, or equal to "CAPH", so a vnet it created is never cleaned up
# and one tagged with a different owner would be deleted. Expect to remove this by hand.
VNET_NAME="ocp-vnet"
VNET_RESOURCE_GROUP="ocp-guests"

# MOC storage container for the VM configuration and OS disks.
STORAGE_CONTAINER="ocp-storage"

# SSH public key, base64 encoded, for the core user.
#
# The reconciler runs base64.StdEncoding.DecodeString() over this and fails the machine if it does
# not decode, so this must be the encoded form:
#   SSH_PUBLIC_KEY_B64="$(base64 -w0 < ~/.ssh/id_ed25519.pub)"   # Linux
#   SSH_PUBLIC_KEY_B64="$(base64 < ~/.ssh/id_ed25519.pub | tr -d '\n')"  # macOS
SSH_PUBLIC_KEY_B64=""

# VM sizes, as MOC VirtualMachineSizeTypes.
CONTROL_PLANE_VM_SIZE="Standard_D8s_v3"
BOOTSTRAP_VM_SIZE="Standard_D8s_v3"
WORKER_VM_SIZE="Standard_D4s_v3"

# Worker MachineDeployment replica count.
#
# Leave at 0 for the initial install and scale up afterwards. Bringing workers up one at a time is
# not just caution: link-nodes.sh can only match a Machine to its Node when exactly one of each is
# unmatched, because CAPHCI exposes neither the VM's IP nor its MAC. See the "worker node
# lifecycle" section of docs/azurestackhci-port-plan.md.
WORKER_REPLICAS="0"

# API virtual IP.
#
# Must match apiVIPs[0] in install-config.yaml. This is served in-cluster by the keepalived and
# haproxy static pods the machine-config-operator runs on the baremetal platform, so it is not a
# load balancer we create -- it floats onto whichever control plane node holds it.
API_VIP="192.168.1.10"

# Kubernetes version recorded on the AzureStackHCICluster. Informational for our purposes: the
# actual control plane version comes from the OpenShift release payload.
KUBERNETES_VERSION="v1.30.0"

# Core Cluster API apiVersion served by the management cluster. CAPHCI master builds against
# CAPI v1.13.x and imports cluster.x-k8s.io/v1beta2.
CAPI_CORE_VERSION="v1beta2"

# Optional: static networking instead of DHCP.
#
# Leave empty to use DHCP, which is the default and the documented OpenShift baremetal path.
#
# If the segment has no usable DHCP, set per-node kernel arguments here and the master image stops
# being shareable -- build-image.sh will produce one image per node instead of three. Format is
# one ip= karg per node in the order bootstrap, master-0, master-1, master-2:
#   STATIC_NETWORK_KARGS=(
#     "ip=192.168.1.20::192.168.1.1:255.255.255.0:bootstrap.ocp.example.com:ens3:none"
#     "ip=192.168.1.21::192.168.1.1:255.255.255.0:master-0.ocp.example.com:ens3:none"
#     "ip=192.168.1.22::192.168.1.1:255.255.255.0:master-1.ocp.example.com:ens3:none"
#     "ip=192.168.1.23::192.168.1.1:255.255.255.0:master-2.ocp.example.com:ens3:none"
#   )
#   STATIC_NAMESERVER="192.168.1.1"
STATIC_NETWORK_KARGS=()
STATIC_NAMESERVER=""
